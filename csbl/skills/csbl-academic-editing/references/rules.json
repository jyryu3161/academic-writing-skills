 "external_id_patterns": [
  "^CORE-[A-Z]+-[0-9]{2}$",
  "^MOD-[A-Z]+-[0-9]{2}$"
 ],
 "sections_note": "sections lists the manuscript sections a rule (and its lint check) applies to; 'all' means every section except References/Acknowledgements. lab-lint style.mjs reads this field to scope each check.",
 "target_policy": "Target values for new manuscripts are the 2019-2026 values of the style profile (31 papers: OA 16 + literature 15). ALL (73 papers) and earlier eras are quoted for comparison only. Where no 2019-2026 split exists the rule says so and quotes ALL as a reference, not as a target.",
 "precedence": [
  "CSBL-INTEG-01 and upstream universal integrity",
  "target journal rules (CSBL-UNIT-01)",
  "manuscript_eval core rubric (CORE-*)",
  "CSBL style rules"
 ],
 "rules": [
  {
   "rule_id": "CSBL-FIG-01",
   "area": "figures",
   "kind": "mechanical",
   "lint_code": "style/figref-narrative",
   "level": "warning",
   "sections": [
    "all"
   ],
   "rule": "그림·표 참조는 괄호로 단다. 'as shown in Fig.'나 'Figure 2 shows' 같은 서술형 참조를 쓰지 않고, 근거 문장 끝에 (Fig. 2a)처럼 둔다.",
   "target": "2019-2026: 괄호형 95.4% (논문별 평균), 94.8% (참조 가중)",
   "comparison": "ALL 88.0% (가중 91.4%); 1998-2010 70.4%",
   "evidence": [
    "SP-01",
    "profile §7"
   ],
   "rubric_ids": [
    "CORE-RES-02",
    "CORE-FIG-02"
   ],
   "vendor_refs": [
    "upstream:skills/academic-writing-skills/references/figures-tables-and-supplements.md",
    "rpws:research-paper-writing/references/experiments.md"
   ]
  },
